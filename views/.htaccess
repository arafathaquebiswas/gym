# View templates are rendered by the controllers, never requested directly.
# Serving them over the web would run them outside the app (leaking notices and
# markup fragments), so deny the whole folder.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
