# Credentials — never commit
config/env.php
config/env.local.php

# Databases and dumps: these carry admin password hashes and customer data
database/gym.sqlite
database/hostinger_import.sql

# Runtime
logs/*.log
.DS_Store

# Member/customer uploads (keep the folder scaffolding, not the files)
uploads/**
!uploads/**/
!uploads/**/.gitkeep
!uploads/.htaccess

# vendor/ is deliberately committed: Hostinger shared hosting has no composer.

# The live SQLite database must never be committed. public_html on the server is a
# git working copy, so anything tracked here overwrites the live file on every
# deploy — this is exactly how production data was lost. The server reads its
# database from DB_SQLITE_PATH (config/env.php), outside the deployed tree.
